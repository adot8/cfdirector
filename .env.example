# cp .env.example .env && chmod 600 .env
# Token: dash.cloudflare.com > My Profile > API Tokens > Create Custom Token. Permissions:
#   Account | Cloudflare Tunnel            | Edit
#   Account | Access: Apps and Policies   | Edit
#   Account | Access: Service Tokens      | Edit
#   Zone    | DNS                         | Edit
#   Zone    | Zone                        | Read
# Account resources: your account. Zone resources: the zone(s) you'll use.
# (Worker deploy + custom domain go through `wrangler login`, so no Workers permission needed here.)
CF_API_TOKEN=
# Account ID: dashboard > any zone's Overview page, right sidebar
CF_ACCOUNT_ID=
# Email allowed through Cloudflare Access to reach an `--internal` service directly.
# Only needed if you use --internal.
OWNER_EMAIL=
